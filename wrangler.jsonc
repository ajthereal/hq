// Cloudflare Workers Builds serves the Vite output as static assets.
// single-page-application: unknown paths like /people return index.html instead of 404.
{
  "name": "hq",
  "compatibility_date": "2026-10-01",
  // Runs before deploy, so dist/ exists even if the dashboard build command is empty.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview`, which Cloudflare runs for pull request branches.
  "previews": {}
}
